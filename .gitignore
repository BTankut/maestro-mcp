# Node modules
node_modules/
*/node_modules/

# Build output
dist/
build/
*.js.map

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test coverage
coverage/
*.lcov
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# MCP Official Docs (local reference)
MCP_official_docs/

# Shared state files (runtime generated)
shared/clients/*.json
shared/tasks/*.json
shared/plans/*.json
shared/reports/*.json

# Keep the directories but ignore the JSON files
!shared/clients/.gitkeep
!shared/tasks/.gitkeep
!shared/plans/.gitkeep
!shared/reports/.gitkeep